---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="পাতা পাওয়া যায়নি — রবীন্দ্র সরোবর পর্যটক নির্দেশিকা" description="অনুরোধ করা পাতাটি পাওয়া যায়নি।" noindex>
  <section class="notfound">
    <div>
      <p class="eyebrow">পাতা পাওয়া যায়নি</p>
      <h1>৪০৪</h1>
      <p>আপনি যে পাতাটি খুঁজছেন সেটি সরানো হয়েছে, নাম বদলেছে বা ঠিকানায় ভুল থাকতে পারে।</p>
      <a class="btn" style="background:var(--deep); color:white;" href="/">প্রথম পাতায় ফিরুন</a>
    </div>
