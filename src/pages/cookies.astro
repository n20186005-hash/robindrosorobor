---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteName } from '../data/site';
---
<BaseLayout
  title={withSiteName('কুকি সেটিংস')}
  description="রবীন্দ্র সরোবর ঢাকা নির্দেশিকার Google Analytics পছন্দ, সংরক্ষণ ব্যর্থতার সীমা ও পৃথক তৃতীয় পক্ষের সংযোগ সম্পর্কে তথ্য।"
  pageClass="legal-page"
>
  <section class="legal-hero">
    <div class="shell">
      <a class="legal-back" href="/">← প্রথম পাতায় ফিরুন</a>
      <p class="eyebrow">আপনার নিয়ন্ত্রণ</p>
      <h1>কুকি সেটিংস</h1>
      <p>সর্বশেষ হালনাগাদ: ২২ অক্টোবর ২০২৬</p>
    </div>
  </section>
  <section class="legal-content">
    <article class="shell prose">
      <p class="notice">
        আপনি কোন ঐচ্ছিক প্রযুক্তি চালু রাখতে চান তা এখানে নিয়ন্ত্রণ করতে পারেন। Google Analytics আপনার স্পষ্ট সম্মতি ছাড়া চালু হয় না। এই নিয়ন্ত্রণ মানচিত্র বা হোস্টিংয়ের পৃথক কর্মক্ষমতা পরিমাপ বন্ধ করে না।
      </p>

      <h2>কুকি কীভাবে ব্যবহার করি</h2>
      <p>আমরা সাইটের মৌলিক কার্যক্রম, আপনার পছন্দ সংরক্ষণ এবং—শুধু অনুমতি দিলে—সমষ্টিগত ব্যবহার বিশ্লেষণের জন্য কুকি বা অনুরূপ ব্রাউজার স্টোরেজ ব্যবহার করতে পারি।</p>

      <div class="cookie-panel" id="কুকি-নিয়ন্ত্রণ">
        <div class="cookie-row">
          <div><h3>মূল পাতার সুবিধা</h3><p>দর্শনার্থী তথ্য বিশ্লেষণের অনুমতি ছাড়াই পড়া যায়। পছন্দ সংরক্ষণ ব্রাউজারের স্টোরেজ ব্যবহারের সুযোগের ওপর নির্ভর করে।</p></div>
          <span class="status-pill">সবসময় সক্রিয়</span>
        </div>

        <label class="cookie-row">
          <div><h3>বিশ্লেষণমূলক কুকি</h3><p>গুগল অ্যানালিটিক্সের মাধ্যমে সমষ্টিগত ও ব্যবহারভিত্তিক তথ্য বুঝতে সাহায্য করে। সম্মতি দিলে তবেই স্ক্রিপ্ট লোড হয়।</p></div>
          <span class="toggle"><input id="বিশ্লেষণ" type="checkbox" /> সক্রিয়</span>
        </label>

        <label class="cookie-row">
          <div><h3>পছন্দ-সংক্রান্ত স্টোরেজ</h3><p>সাইট কেবল বাংলায় এবং আলাদা থিম বা ভাষা-পছন্দ সংরক্ষণ করে না। এই নিষ্ক্রিয় শ্রেণির কোনো আলাদা অনুমতি নেওয়া হয় না।</p></div>
          <span class="toggle"><input id="পছন্দ" type="checkbox" disabled /> ব্যবহার করা হয় না</span>
        </label>

        <div class="cookie-row">
          <div><h3>বিপণন কুকি</h3><p>ব্যক্তিকেন্দ্রিক বিজ্ঞাপন বা বিজ্ঞাপন প্রচারের মাপজোকের জন্য। এই অলাভজনক সাইট বর্তমানে এ ধরনের কুকি ব্যবহার করে না।</p></div>
          <span class="status-pill off">নিষ্ক্রিয়</span>
        </div>
      </div>

      <h2>সম্মতি ব্যবস্থাপনা</h2>
      <p>আপনি যেকোনো সময় এই পাতায় ফিরে পছন্দ পরিবর্তন করতে পারেন। প্রত্যাখ্যান করলে ইতিমধ্যে লোড হওয়া বিশ্লেষণও বন্ধ হয়। সংরক্ষণ ব্যর্থ হলে একই ট্যাবের সেশন বা নামের অবস্থায় প্রত্যাখ্যান রাখার চেষ্টা হয়; সব ব্যবস্থা ব্যর্থ হলে শুধু বর্তমান পাতায় বন্ধ থাকার নিশ্চয়তা থাকে। নতুন অনুমতি যাচাই করা না গেলে তা প্রত্যাখ্যান বা মুছে ফেলার চেষ্টা হয়। উভয় কাজ ব্যর্থ হলে সংরক্ষিত অনুমতি থেকে যেতে পারে এবং অন্য ট্যাবে ব্যবহার হতে পারে; ব্রাউজার থেকে সাইটের ডেটা মুছতে পারেন।</p>
      <div class="cookie-actions">
        <button class="save" id="পছন্দ-সংরক্ষণ" type="button">পছন্দ সংরক্ষণ করুন</button>
        <button class="reject" id="সব-প্রত্যাখ্যান" type="button">ঐচ্ছিক সব প্রত্যাখ্যান করুন</button>
      </div>
      <p class="cookie-feedback" id="কুকি-বার্তা" aria-live="polite"></p>

      <h2>তৃতীয় পক্ষের কুকি</h2>
      <p>
        এমবেড করা গুগল মানচিত্র নিজের প্রয়োজন অনুযায়ী কুকি বা অনুরূপ প্রযুক্তি ব্যবহার করতে পারে। মানচিত্র একটি বাহ্যিক এমবেড; সেটির সব স্টোরেজ আমাদের কুকি-সুইচ দিয়ে নিয়ন্ত্রণ করা সম্ভব নয়। আপনি চাইলে ব্রাউজারের গোপনীয়তা সেটিংস দিয়ে তৃতীয় পক্ষের কুকি আরও সীমিত করতে পারেন।
      </p>

<h2>হোস্টিংয়ের কর্মক্ষমতা পরিমাপ</h2><p>Cloudflare Web Analytics পাতা দেখা ও লোড হওয়ার কর্মক্ষমতা মাপতে একটি ব্রাউজার beacon যোগ করতে পারে। এটি Google Analytics থেকে আলাদা; এই পাতার Google Analytics পছন্দ দিয়ে এটি বন্ধ হয় না। ব্রাউজার, বিষয়বস্তু-রোধক বা নিরাপত্তা নীতি স্ক্রিপ্ট বা অনুরোধ আটকাতে পারে। স্ক্রিপ্ট থাকা মানেই তথ্য পাঠানো সফল হয়েছে নয়। <a href="https://developers.cloudflare.com/web-analytics/about/">Cloudflare-এর ব্যাখ্যা</a> দেখুন।</p><h2>আবহাওয়ার তথ্য</h2><p>আবহাওয়ার তথ্য Open-Meteo থেকে আসে। পাতা লোড হলে ব্রাউজার পূর্বনির্ধারিত স্থানের স্থানাঙ্কসহ সেই সেবায় অনুরোধ পাঠায়; দর্শনার্থীর নিজস্ব অবস্থান চাওয়া হয় না।</p>
      <h2>আরও তথ্য</h2>
      <p>ব্যক্তিগত তথ্যের ব্যবহার, তৃতীয় পক্ষের সেবা ও আপনার অধিকার সম্পর্কে বিস্তারিত জানতে <a href="/privacy/">গোপনীয়তা নীতি</a> পড়ুন।</p>
    </article>
  </section>


</BaseLayout>
