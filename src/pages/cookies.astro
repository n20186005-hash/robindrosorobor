---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteName } from '../data/site';
---
<BaseLayout
  title={withSiteName('কুকি সেটিংস')}
  description="প্রয়োজনীয়, বিশ্লেষণ, পছন্দ ও বিপণন-সংক্রান্ত কুকি সম্পর্কে তথ্য এবং রবীন্দ্র সরোবর পর্যটক নির্দেশিকার কুকি পছন্দ নিয়ন্ত্রণ।"
  pageClass="legal-page"
>
  <section class="legal-hero">
    <div class="shell">
      <a class="legal-back" href="/">← প্রথম পাতায় ফিরুন</a>
      <p class="eyebrow">আপনার নিয়ন্ত্রণ</p>
      <h1>কুকি সেটিংস</h1>
      <p>সর্বশেষ হালনাগাদ: আগস্ট ২০২৬</p>
    </div>
  </section>
  <section class="legal-content">
    <article class="shell prose">
      <p class="notice">
        আপনি কোন ঐচ্ছিক প্রযুক্তি চালু রাখতে চান তা এখানে নিয়ন্ত্রণ করতে পারেন। প্রয়োজনীয় স্টোরেজ সাইটের মৌলিক কার্যক্রম ও আপনার সম্মতির সিদ্ধান্ত মনে রাখার জন্য ব্যবহৃত হয়; বিশ্লেষণ আপনার স্পষ্ট সম্মতি ছাড়া চালু হয় না।
      </p>

      <h2>কুকি কীভাবে ব্যবহার করি</h2>
      <p>আমরা সাইটের মৌলিক কার্যক্রম, আপনার পছন্দ সংরক্ষণ এবং—শুধু অনুমতি দিলে—সমষ্টিগত ব্যবহার বিশ্লেষণের জন্য কুকি বা অনুরূপ ব্রাউজার স্টোরেজ ব্যবহার করতে পারি।</p>

      <div class="cookie-panel" id="কুকি-নিয়ন্ত্রণ">
        <div class="cookie-row">
          <div><h3>প্রয়োজনীয় কুকি</h3><p>সাইটের মূল কার্যক্রম ও সম্মতির রেকর্ড রাখার জন্য দরকার। এগুলো বন্ধ করা যায় না।</p></div>
          <span class="status-pill">সবসময় সক্রিয়</span>
        </div>

        <label class="cookie-row">
          <div><h3>বিশ্লেষণমূলক কুকি</h3><p>গুগল অ্যানালিটিক্সের মাধ্যমে সমষ্টিগত ও ব্যবহারভিত্তিক তথ্য বুঝতে সাহায্য করে। সম্মতি দিলে তবেই স্ক্রিপ্ট লোড হয়।</p></div>
          <span class="toggle"><input id="বিশ্লেষণ" type="checkbox" /> সক্রিয়</span>
        </label>

        <label class="cookie-row">
          <div><h3>পছন্দ-সংক্রান্ত স্টোরেজ</h3><p>ভাষা, প্রদর্শন বা ভবিষ্যৎ সাইট-পছন্দ মনে রাখতে ব্যবহারের অনুমতি। বর্তমানে সাইট একমাত্র বাংলা ভাষায় এবং আলাদা থিম সংরক্ষণ করে না।</p></div>
          <span class="toggle"><input id="পছন্দ" type="checkbox" /> সক্রিয়</span>
        </label>

        <div class="cookie-row">
          <div><h3>বিপণন কুকি</h3><p>ব্যক্তিকেন্দ্রিক বিজ্ঞাপন বা বিজ্ঞাপন প্রচারের মাপজোকের জন্য। এই অলাভজনক সাইট বর্তমানে এ ধরনের কুকি ব্যবহার করে না।</p></div>
          <span class="status-pill off">নিষ্ক্রিয়</span>
        </div>
      </div>

      <h2>সম্মতি ব্যবস্থাপনা</h2>
      <p>আপনি যেকোনো সময় এই পাতায় ফিরে পছন্দ পরিবর্তন করতে পারেন। কিছু ঐচ্ছিক প্রযুক্তি বন্ধ করলে ভবিষ্যতের কিছু সুবিধা সীমিত হতে পারে, তবে মূল দর্শনার্থী তথ্য পড়তে বাধা দেওয়ার উদ্দেশ্য নেই।</p>
      <div class="cookie-actions">
        <button class="save" id="পছন্দ-সংরক্ষণ" type="button">পছন্দ সংরক্ষণ করুন</button>
        <button class="reject" id="সব-প্রত্যাখ্যান" type="button">ঐচ্ছিক সব প্রত্যাখ্যান করুন</button>
      </div>
      <p class="cookie-feedback" id="কুকি-বার্তা" aria-live="polite"></p>

      <h2>তৃতীয় পক্ষের কুকি</h2>
      <p>
        এমবেড করা গুগল মানচিত্র নিজের প্রয়োজন অনুযায়ী কুকি বা অনুরূপ প্রযুক্তি ব্যবহার করতে পারে। মানচিত্র একটি বাহ্যিক এমবেড; সেটির সব স্টোরেজ আমাদের কুকি-সুইচ দিয়ে নিয়ন্ত্রণ করা সম্ভব নয়। আপনি চাইলে ব্রাউজারের গোপনীয়তা সেটিংস দিয়ে তৃতীয় পক্ষের কুকি আরও সীমিত করতে পারেন।
      </p>

      <h2>আরও তথ্য</h2>
      <p>ব্যক্তিগত তথ্যের ব্যবহার, তৃতীয় পক্ষের সেবা ও আপনার অধিকার সম্পর্কে বিস্তারিত জানতে <a href="/privacy/">গোপনীয়তা নীতি</a> পড়ুন।</p>
    </article>
  </section>

  <script is:inline>
    (() => {
      const key = 'রবীন্দ্র-সরোবর-কুকি-পছন্দ';
      const analytics = document.getElementById('বিশ্লেষণ');
      const preferences = document.getElementById('পছন্দ');
      const save = document.getElementById('পছন্দ-সংরক্ষণ');
      const reject = document.getElementById('সব-প্রত্যাখ্যান');
      const feedback = document.getElementById('কুকি-বার্তা');

      const read = () => {
        try { return JSON.parse(localStorage.getItem(key) || '{}'); }
        catch { return {}; }
      };
      const current = read();
      analytics.checked = Boolean(current.analytics);
      preferences.checked = Boolean(current.preferences);

      const persist = (value) => {
        localStorage.setItem(key, JSON.stringify(value));
        window['ga-disable-G-HXM22WWPKP'] = !value.analytics;
        window.dispatchEvent(new CustomEvent('কুকি-পছন্দ-বদলেছে'));
        feedback.textContent = 'আপনার পছন্দ এই ব্রাউজারে সংরক্ষণ করা হয়েছে।';
      };

      save.addEventListener('click', () => {
        persist({ necessary: true, analytics: analytics.checked, preferences: preferences.checked, marketing: false });
      });

      reject.addEventListener('click', () => {
        analytics.checked = false;
        preferences.checked = false;
        persist({ necessary: true, analytics: false, preferences: false, marketing: false });
      });
    })();
  </script>
</BaseLayout>
