---
import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';
import { attraction, photos, faqs, seo, SITE_NAME, seasonal, itineraries, routes } from '../data/site';

const ownUrl = Astro.site ? new URL('/', Astro.site).toString() : undefined;
const latitudeBn = attraction.latitude.toLocaleString('bn-BD', { minimumFractionDigits: 6, maximumFractionDigits: 6 });
const longitudeBn = attraction.longitude.toLocaleString('bn-BD', { minimumFractionDigits: 6, maximumFractionDigits: 6 });

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Amphitheatre'],
  '@id': ownUrl ? `${ownUrl}#attraction` : undefined,
  name: attraction.name,
  alternateName: [
    seo.attractionFullNameEn,
    `${seo.attractionFullNameEn}, ${seo.cityEn}`,
    'রবীন্দ্র সরোবর মুক্তমঞ্চ',
    'রবীন্দ্র সরোবর অ্যাম্ফিথিয়েটার',
  ],
  description:
    'রবীন্দ্র সরোবর (Robindro Sorobor) — ঢাকার ধানমন্ডি লেকের পাশে অবস্থিত উন্মুক্ত সাংস্কৃতিক মঞ্চ ও নগর জনপরিসরের বিস্তারিত দর্শনার্থী নির্দেশিকা।',
  ...(ownUrl ? { url: ownUrl } : {}),
  image: [photos.hero.src, photos.stage.src],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '৮ নম্বর, ধানমন্ডি লেক রোড',
    addressLocality: 'ঢাকা',
    addressRegion: 'ঢাকা',
    postalCode: '১২০৫',
    addressCountry: 'BD',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude,
  },
  hasMap: seo.mapsShareUrl,
  sameAs: [seo.mapsShareUrl, seo.wikimediaCategory],

};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---
<BaseLayout
  title={`রবীন্দ্র সরোবর (Robindro Sorobor) ধানমন্ডি, ঢাকা — পর্যটক নির্দেশিকা`}
  description="রবীন্দ্র সরোবর (Robindro Sorobor) ঢাকার ধানমন্ডি লেক রোড ৮ নম্বরে—কীভাবে যাবেন, কখন যাবেন, উন্মুক্ত মঞ্চ, ইতিহাস, যাতায়াত, পার্কিং ও সাধারণ জিজ্ঞাসা নিয়ে স্বাধীন বাংলা দর্শনার্থী নির্দেশিকা।"
  imagePath={photos.hero.src}
  imageAlt="রবীন্দ্র সরোবর (Robindro Sorobor) — ধানমন্ডি লেকের উন্মুক্ত মঞ্চ, ঢাকা"
  structuredData={[attractionSchema, faqSchema]}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media">
      <img src={photos.hero.src} alt={photos.hero.alt} width="2048" height="1536" fetchpriority="high" />
    </div>
    <div class="shell hero-content">
      <p class="hero-kicker">লেক · মঞ্চ · নগর সংস্কৃতি</p>
      <h1 id="hero-title">রবীন্দ্র<br />সরোবর</h1>
      <p class="hero-lead">
        ধানমন্ডি লেকের জলরেখা ঘেঁষে একটি উন্মুক্ত মঞ্চ—যেখানে হাঁটা, আড্ডা, গান, কবিতা ও জনসমাগম
        ঢাকার দৈনন্দিন সংস্কৃতির সঙ্গে একই দৃশ্যপটে মিশে যায়।
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#ভ্রমণ-পরিকল্পনা">ভ্রমণ পরিকল্পনা দেখুন</a>
        <a class="btn btn-secondary" href="#মানচিত্র">মানচিত্রে অবস্থান</a>
      </div>
    </div>
      <p class="hero-photo-credit">ছবি: {photos.hero.credit} · {photos.hero.title} · {photos.hero.dateLabel} · মূল ফাইল অপরিবর্তিত; পর্দায় অংশবিশেষ দেখা যেতে পারে। · <a href={photos.hero.licenseUrl} rel="noreferrer">{photos.hero.license}</a> · <a href={photos.hero.source} rel="noreferrer">উৎস</a></p>
  </section>

  <div class="shell hero-facts" aria-label="দ্রুত তথ্য">
    <div class="fact-strip">
      <div class="fact"><span>অবস্থান</span><strong>ধানমন্ডি ৮ নম্বর লেক এলাকা</strong></div>
      <div class="fact"><span>সাধারণ প্রবেশ</span><strong>নিয়ম আগে নিশ্চিত করুন</strong></div>
      <div class="fact"><span>মানচিত্র তালিকা</span><strong>খোলার সময় পাওয়া যায়নি</strong></div>
      <div class="fact"><span>দর্শনার্থী মূল্যায়ন</span><strong>Google Maps: ৪.৪ / ৫</strong></div>
    </div>
  </div>

  <p class="shell" style="padding-top:1.5rem;">Google Maps · ২২ অক্টোবর ২০২৬: ৪.৪/৫, ৪৯,৯৮০টি মূল্যায়ন। এটি তৃতীয় পক্ষের পরিবর্তনশীল তালিকা, এই সাইটের নিজস্ব মূল্যায়ন নয়। <a href={seo.mapsShareUrl}>স্থানটির তালিকা ও বর্তমান নির্দেশনা দেখুন</a>। তালিকায় খোলার সময় দেখা যায়নি।</p>

  <section class="section" id="পরিচিতি">
    <div class="shell grid-2">
      <div class="intro-card">
        <p class="eyebrow">এক নজরে</p>
        <h2 class="section-title">একটি মঞ্চের চেয়ে বেশি—এটি শহরের ব্যবহৃত জনপরিসর</h2>
        <p>
          রবীন্দ্র সরোবর ধানমন্ডি লেকের পাশে নির্মিত ধাপভিত্তিক উন্মুক্ত অ্যাম্ফিথিয়েটার। আনুষ্ঠানিক অনুষ্ঠান না থাকলেও
          এখানে মানুষ বসে, হাঁটে, গল্প করে, অনুশীলন করে বা শুধু লেকের বাতাস নেয়। তাই এটিকে শুধু “দর্শনীয় স্থান” হিসেবে
          নয়, বরং ঢাকার একটি জীবন্ত নাগরিক পরিসর হিসেবে দেখলে জায়গাটির চরিত্র সবচেয়ে ভালো বোঝা যায়।
        </p>
        <p>
          ইংরেজি বা রোমানিকৃত নামে এটি <strong>Robindro Sorobor, Dhaka</strong> হিসেবেও পরিচিত—ডোমেইন
          <strong>robindrosorobor.com</strong>-এর অর্থও এই একই সত্তা (রবীন্দ্র সরোবর) নির্দেশ করে। সুতরাং সন্ধানী
          বা মানচিত্রে “Robindro Sorobor” লিখলেও এখানেই আসে।
        </p>
        <p>
          উন্মুক্ত সূত্রে এটি রবীন্দ্র সরোবর, রবীন্দ্র সরোবর মুক্তমঞ্চ ও রবীন্দ্র সরোবর অ্যাম্ফিথিয়েটার—এই কয়েক নামে
          উল্লেখিত। কলকাতার একই নামের স্থানটির সঙ্গে যেন গুলিয়ে না যায়, তাই এই নির্দেশিকায় সর্বত্র ধানমন্ডি, ঢাকা
          পরিচয়টি স্পষ্ট রাখা হয়েছে।
        </p>
        <blockquote class="pullquote">
          এখানে অভিজ্ঞতার মূল আকর্ষণ কোনো একক স্থাপত্য নয়; জল, বৃক্ষ, ধাপ, মানুষের উপস্থিতি ও সাংস্কৃতিক ব্যবহারের
          সম্মিলনই জায়গাটিকে আলাদা করে।
        </blockquote>
      </div>
      <figure class="photo-frame">
        <img src={photos.stage.src} alt={photos.stage.alt} width="2048" height="1536" loading="lazy" />
        <figcaption class="photo-credit">
          ছবি: {photos.stage.credit} · {photos.stage.title} · {photos.stage.dateLabel} · মূল ফাইল অপরিবর্তিত; পর্দায় অংশবিশেষ দেখা যেতে পারে। · <a href={photos.stage.licenseUrl} rel="noreferrer">{photos.stage.license}</a> · <a href={photos.stage.source} rel="noreferrer">উৎস</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section history-section" id="ইতিহাস">
    <div class="shell">
      <p class="eyebrow">ইতিহাস ও সাংস্কৃতিক প্রেক্ষিত</p>
      <h2 class="section-title">ধানমন্ডি লেক থেকে নাগরিক সাংস্কৃতিক মঞ্চে</h2>
      <p class="section-lead">
        ধানমন্ডি এলাকার নগরায়ণ, লেককে ঘিরে জনপরিসর উন্নয়ন এবং পরবর্তী সাংস্কৃতিক ব্যবহারের ধারার ভেতরেই রবীন্দ্র
        সরোবরের বর্তমান পরিচয় গড়ে উঠেছে। নথি ও সংবাদসূত্র যেখানে অনিশ্চিত, সেখানে আমরা অনুমানকে তথ্য হিসেবে
        উপস্থাপন করিনি।
      </p>

      <div class="timeline" aria-label="ঐতিহাসিক ধারাবাহিকতা">
        <article class="timeline-item">
          <strong>লেকের পুরোনো জলভূমি</strong>
          <p>ধানমন্ডি লেকের জলরেখা ঢাকার পুরোনো খাল ও জলপ্রবাহ ব্যবস্থার ইতিহাসের সঙ্গে যুক্ত; নগর সম্প্রসারণে এর ভূমিকা বদলেছে।</p>
        </article>
        <article class="timeline-item">
          <strong>পরিকল্পিত ধানমন্ডি</strong>
          <p>বিশ শতকের মাঝামাঝি ধানমন্ডি আবাসিক এলাকার বিকাশের সঙ্গে লেকটি শহুরে উন্মুক্ত জলাধার ও সবুজ পরিসর হিসেবে পরিচিতি পায়।</p>
        </article>
        <article class="timeline-item">
          <strong>উন্মুক্ত মঞ্চের আবির্ভাব</strong>
          <p>২৭ ফেব্রুয়ারি ২০২৬-এর The Business Standard প্রতিবেদন মঞ্চটি দুই হাজারের দশকের শুরুতে নির্মিত হয়ে থাকতে পারে বলে উল্লেখ করে। এটি সম্ভাব্য সময়; সুনির্দিষ্ট উদ্বোধনী নথি এখানে যাচাই করা হয়নি।</p>
        </article>
        <article class="timeline-item">
          <strong>চলমান সাংস্কৃতিক ব্যবহার</strong>
          <p>২৭ ফেব্রুয়ারি ২০২৬-এর প্রতিবেদনে প্রায় দুই দশকের থিয়েটার, সংগীত, কবিতা ও স্থানীয় শিল্পীদের ব্যবহারের কথা বলা হয়েছে; এটি আনুষ্ঠানিক প্রতিষ্ঠাকালের প্রমাণ নয়।</p>
        </article>
      </div>

      <aside class="update-note" aria-label="সাম্প্রতিক অবকাঠামো প্রেক্ষিত">
        <strong>সাম্প্রতিক অবকাঠামো প্রেক্ষিত</strong>
        <p>
          ২৪ আগস্ট ২০২৬-এর The Business Standard প্রতিবেদনে ধানমন্ডি লেকের উন্নয়ন পরিকল্পনার কথা বলা হয়েছে। পরিকল্পিত সুবিধাকে এখানে চালু সুবিধা হিসেবে ধরা হয়নি। পরিকল্পনা বাস্তবায়নের পর্যায়ে কোনো অংশ সাময়িকভাবে ঘেরা, পথ পরিবর্তিত বা কম ব্যবহারযোগ্য হতে পারে। তাই ভ্রমণের দিন স্থানীয় নির্দেশনা ও কর্তৃপক্ষের নোটিশকে অগ্রাধিকার দিন।
        </p>
      </aside>

      <aside class="update-note" aria-label="সাংস্কৃতিক ভূমিকা">
        <strong>সাংস্কৃতিক ভূমিকা ও নামের তাৎপর্য</strong>
        <p>
          “রবীন্দ্র” রবীন্দ্রনাথ ঠাকুরের (১৮৬১–১৯৪১) সংক্ষিপ্ত রূপ—তিনি সাহিত্যে নোবেল পুরস্কার পাওয়া প্রথম এশীয়, যাঁর গান, কবিতা ও নাটক বাংলা সংস্কৃতির মূল স্রোতে জায়গা করে নিয়েছে। এই নামের সাংস্কৃতিক অনুষঙ্গ আছে; আনুষ্ঠানিক নামকরণের নথি এখানে যাচাই করা হয়নি।
        </p>
        <p>
          বৈশাখী বা শীতকালীন সাংস্কৃতিক আয়োজন, থিয়েটার ও কবিতার সমাবেশে মঞ্চটি বিশেষভাবে সরব থাকে। তবে নামের আনুষ্ঠানিক উৎস নিয়ে স্পষ্ট সরকারি নথি সহজলভ্য নয়—তাই এটিকে জনপ্রিয় কাহিনি হিসেবে নয়, সাংস্কৃতিক প্রেক্ষিত হিসেবে তুলে ধরা হয়েছে।
        </p>
      </aside>

      <div class="history-image" style="grid-template-columns:1fr;">
        <div class="history-note">
          <h3>নাম, স্মৃতি ও একটি গুরুত্বপূর্ণ সতর্কতা</h3>
          <p>
            “রবীন্দ্র সরোবর” নামটি রবীন্দ্রনাথ ঠাকুরের সাংস্কৃতিক অনুষঙ্গ বহন করে এবং উন্মুক্ত গণমাধ্যমে বহুল ব্যবহৃত।
            তবে সাম্প্রতিক প্রতিবেদনে স্থানটির আনুষ্ঠানিক নামকরণের নথি স্পষ্ট নয় বলা হয়েছে। তাই নামের উৎস নিয়ে কোনো
            জনপ্রিয় কাহিনিকে আমরা সরকারি ইতিহাস হিসেবে দাবি করছি না।
          </p>
          <p>
            সাম্প্রতিক আলোচনায় রক্ষণাবেক্ষণ, জলাবদ্ধতা, শব্দ ও বাণিজ্যিক ব্যবহারের চাপের কথাও উঠে এসেছে। এসব বাস্তবতা
            বোঝা গুরুত্বপূর্ণ, কারণ পেশাদার দর্শনার্থী নির্দেশিকার কাজ শুধু সুন্দর দিক দেখানো নয়—জনপরিসরের ব্যবহার ও
            সীমাবদ্ধতাও নিরপেক্ষভাবে জানানো।
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="ভ্রমণ-পরিকল্পনা">
    <div class="shell">
      <p class="eyebrow">ভ্রমণ পরিকল্পনা</p>
      <h2 class="section-title">সময়, খরচ, ভিড় ও আবহাওয়া—যাওয়ার আগে যা জানা দরকার</h2>
      <p class="section-lead">
        এটি প্রচলিত গেট-টিকিটভিত্তিক পর্যটনকেন্দ্র নয়। জনপরিসরের নিয়ম, অনুষ্ঠান, আবহাওয়া ও ভিড়ের কারণে অভিজ্ঞতা দিনে
        দিনে বদলাতে পারে। তাই নিচের তথ্যকে পরিকল্পনার ভিত্তি হিসেবে নিন, চূড়ান্ত নিশ্চয়তা হিসেবে নয়।
      </p>

      <div class="plan-grid">
        <article class="plan-card">
          <span class="num">১</span>
          <h3>সেরা সময়</h3>
          <p>শান্ত পরিবেশের জন্য সকাল; নরম আলো ও সামাজিক আবহের জন্য বিকেল থেকে সূর্যাস্ত। শুক্রবার, ছুটির দিন ও বড় অনুষ্ঠানে ভিড় বেশি হতে পারে।</p>
        </article>
        <article class="plan-card">
          <span class="num">২</span>
          <h3>প্রস্তাবিত অবস্থানকাল</h3>
          <p>সংক্ষিপ্ত দেখায় প্রায় এক ঘণ্টা। লেকপাড় হাঁটা, বসা, আলোকচিত্র বা অনুষ্ঠান থাকলে দুই থেকে তিন ঘণ্টা রাখলে তাড়াহুড়া কম হয়।</p>
        </article>
        <article class="plan-card">
          <span class="num">৩</span>
          <h3>টিকিট ও খরচ</h3>
          <p>বর্তমান প্রবেশমূল্য বা সর্বজনীন বিনামূল্যে প্রবেশের নিয়ম স্বাধীনভাবে যাচাই করা হয়নি। অনুষ্ঠান ও ঐচ্ছিক সেবার আলাদা শর্ত থাকতে পারে; স্থানীয় নির্দেশনা ও আয়োজকের ঘোষণা আগে দেখুন।</p>
        </article>
        <article class="plan-card">
          <span class="num">৪</span>
          <h3>বর্ষা ও সন্ধ্যার প্রস্তুতি</h3>
          <p>বৃষ্টিতে কিছু অংশ পিচ্ছিল বা জলাবদ্ধ হতে পারে। সন্ধ্যায় মশা বাড়তে পারে; পোকামাকড় প্রতিরোধক ও আরামদায়ক জুতা কাজে দেয়।</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="ঋতু-কৌশল">
