---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withSiteName } from '../data/site';
---
<BaseLayout
  title={withSiteName('সেবার শর্তাবলি')}
  description="রবীন্দ্র সরোবর পর্যটক নির্দেশিকা ব্যবহারের শর্ত, তথ্যের সীমাবদ্ধতা, মেধাস্বত্ব, তৃতীয় পক্ষের সেবা এবং দায়সীমা।"
  pageClass="legal-page"
>
  <section class="legal-hero">
    <div class="shell">
      <a class="legal-back" href="/">← প্রথম পাতায় ফিরুন</a>
      <p class="eyebrow">আইনি তথ্য</p>
      <h1>সেবার শর্তাবলি</h1>
      <p>সর্বশেষ হালনাগাদ: ২২ অক্টোবর ২০২৬</p>
    </div>
  </section>
  <section class="legal-content">
    <article class="shell prose">
      <p class="notice">
        এই ওয়েবসাইট ব্যবহার করলে আপনি নিচের শর্তগুলো মেনে সাইটটি ব্যবহার করতে সম্মত হন। আমরা কোনো সরকারি, দাপ্তরিক বা বাণিজ্যিক পর্যটন অপারেটর নই।
      </p>

      <h2>সাইটের পরিচয়</h2>
      <p>
        রবীন্দ্র সরোবর পর্যটক নির্দেশিকা একটি স্বাধীন, তৃতীয়-পক্ষ, অলাভজনক তথ্যপ্রকল্প। রবীন্দ্র সরোবর, ঢাকা দক্ষিণ সিটি কর্পোরেশন, বাংলাদেশ ট্যুরিজম বোর্ড, কোনো সরকারি দপ্তর, অনুষ্ঠান আয়োজক বা স্থানীয় ব্যবসার সঙ্গে আমাদের মালিকানা বা দাপ্তরিক সম্পর্ক নেই।
      </p>

      <h2>বিষয়বস্তুর ব্যবহার</h2>
      <p>
        সাইটের লেখা ভ্রমণ পরিকল্পনা, ইতিহাস ও জনপরিসর সম্পর্কে সাধারণ তথ্যের জন্য। জরুরি নিরাপত্তা, আইনি অনুমতি, অনুষ্ঠানসূচি, প্রবেশনীতি, পরিবহন, চিকিৎসা বা আর্থিক সিদ্ধান্তের একমাত্র উৎস হিসেবে এই সাইট ব্যবহার করা উচিত নয়।
      </p>

      <h2>তথ্যের যথার্থতা</h2>
      <p>
        আমরা সরকারি উন্মুক্ত তথ্য, মানচিত্র তালিকা, সংবাদ প্রতিবেদন ও অন্যান্য নির্ভরযোগ্য সূত্র মিলিয়ে তথ্য উপস্থাপনের চেষ্টা করি। তবু খোলার সময়, প্রবেশব্যবস্থা, যানবাহন, পার্কিং, অনুষ্ঠান, মূল্য, নিরাপত্তা পরিস্থিতি ও সুবিধার কার্যকর অবস্থা দ্রুত বদলাতে পারে। গুরুত্বপূর্ণ সিদ্ধান্তের আগে সংশ্লিষ্ট কর্তৃপক্ষ বা আয়োজকের সাম্প্রতিক তথ্য যাচাই করুন।
      </p>

      <h2>বাণিজ্যিক নিরপেক্ষতা</h2>
      <p>
        খাবার, আবাসন, পরিবহন, মুদি, জ্বালানি বা অন্যান্য সেবার অংশে আমরা নির্দিষ্ট ব্যবসা বা ব্র্যান্ডকে সুপারিশ করি না। কোনো সেবার ধরন উল্লেখ করা মানে সেই সেবাদাতাকে অনুমোদন, নিশ্চয়তা বা প্রচার করা নয়।
      </p>

      <h2>মেধাস্বত্ব ও ছবি</h2>
      <p>
        সাইটের মৌলিক লেখা, তথ্যের বিন্যাস, লোগো ও নকশা—যেখানে অন্যথা উল্লেখ নেই—এই প্রকল্পের সৃজনশীল কাজ। স্থান-নির্দিষ্ট আলোকচিত্রগুলো তাদের নিজ নিজ আলোকচিত্রী বা উৎস প্রতিষ্ঠানের অধিকার ও লাইসেন্সের অধীনে ব্যবহৃত। প্রতিটি ছবির কৃতিত্ব ও উৎস সংশ্লিষ্ট অংশে দেওয়া হয়েছে।
      </p>
      <p>
        এখানে ব্যবহৃত দুটি আলোকচিত্র ক্রিয়েটিভ কমন্স অ্যাট্রিবিউশন-শেয়ারঅ্যালাইক ৩.০ লাইসেন্সে উৎস পাতায় প্রকাশিত। পুনঃব্যবহারের আগে সংশ্লিষ্ট ছবির উৎস পাতার লাইসেন্স নিজে যাচাই করুন; এই সাইট কোনো আলাদা ছবির লাইসেন্স প্রদান করে না।
      </p>

      <h2>গুগল মানচিত্র ও তৃতীয় পক্ষ</h2>
      <p>
        এমবেড করা গুগল মানচিত্রের তথ্য ও ব্যবহার গুগলের প্রযোজ্য শর্তের অধীন। একইভাবে উইকিমিডিয়া কমন্স বা অন্য বাহ্যিক উৎসের লিংক তাদের নিজস্ব নীতি দ্বারা পরিচালিত হয়। বাহ্যিক সাইটের বিষয়বস্তু, প্রাপ্যতা বা নিরাপত্তার জন্য আমরা দায়ী নই।
      </p>

      <h2>গ্রহণযোগ্য ব্যবহার</h2>
      <p>আপনি সাইট ব্যবহার করে এমন কোনো কাজ করবেন না যা:</p>
      <ul>
        <li>সাইটের নিরাপত্তা বা প্রাপ্যতা নষ্ট করার চেষ্টা করে;</li>
        <li>স্বয়ংক্রিয় অপব্যবহার, ক্ষতিকর কোড বা অযৌক্তিক ট্রাফিক সৃষ্টি করে;</li>
        <li>অন্যের মেধাস্বত্ব, গোপনীয়তা বা আইনগত অধিকার লঙ্ঘন করে;</li>
        <li>এই স্বাধীন প্রকল্পকে সরকারি বা দাপ্তরিক উৎস হিসেবে ভুলভাবে উপস্থাপন করে।</li>
      </ul>

      <h2>দায়সীমা</h2>
      <p>
        সাইটটি “যেমন আছে” ভিত্তিতে তথ্য প্রদান করে এবং কোনো নির্দিষ্ট ভ্রমণ-ফল, সুবিধার প্রাপ্যতা বা নিরাপত্তার নিশ্চয়তা দেয় না। আইন যতটুকু অনুমতি দেয়, এই সাইটের তথ্য ব্যবহার বা তার ওপর নির্ভর করে নেওয়া সিদ্ধান্ত থেকে সৃষ্ট প্রত্যক্ষ বা পরোক্ষ ক্ষতির জন্য প্রকল্প দায় গ্রহণ করে না। জরুরি পরিস্থিতিতে স্থানীয় কর্তৃপক্ষ ও প্রাসঙ্গিক জরুরি সেবার নির্দেশনা অনুসরণ করুন।
      </p>

      <h2>শর্ত পরিবর্তন</h2>
      <p>সেবার ধরন বা আইন বদলালে এই শর্ত হালনাগাদ হতে পারে। পরিবর্তিত শর্ত প্রকাশের পর সাইটের ব্যবহার সেই হালনাগাদ শর্তের অধীন থাকবে।</p>
    </article>
  </section>
</BaseLayout>
